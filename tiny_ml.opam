# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
synopsis: "A tiny JAX-style tracer in OCaml"
description:
  "Write numeric code once in OCaml, then evaluate it or differentiate it with forward-mode autodiff."
maintainer: ["Quoc Nguyen" "tu-hm"]
authors: ["Quoc Nguyen" "tu-hm"]
license: "MIT"
homepage: "https://github.com/Ashirog1/tiny.ml"
bug-reports: "https://github.com/Ashirog1/tiny.ml/issues"
depends: [
  "dune" {>= "3.24"}
  "ocaml" {>= "5.0"}
  "ppxlib" {>= "0.35" & < "0.36"}
  "ocamlformat" {with-dev-setup & = "0.29.0"}
  "ocaml-lsp-server" {with-dev-setup}
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/Ashirog1/tiny.ml.git"
x-maintenance-intent: ["(latest)"]
