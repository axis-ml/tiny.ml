-- training --
  loss at step 0                 0.8353981079772941
  loss at step 400               0.00480868128287857
  loss at step 800               0.001905116463841168
  loss at step 1200              0.0009750513919910417
  loss at step 1600              0.0007343026774891093
  loss at step 2000              0.0004559246516595616

-- the network against sin --
  x                              [-2.0 -0.5 1.0 2.5]
  predict                        [-0.8755141676927869 -0.4749899078262743 0.8494035611309897 0.5822452148503715]
  sin x                          [-0.9092974268256817 -0.479425538604203 0.8414709848078965 0.5984721441039565]

=== jit: trace to a graph, compile with jit ===

-- the graph of f, for a scalar --
    params: %0:f64[]
    %3:f64[] = const 1.0
    %1:f64[] = sin(%0)
    %2:f64[] = mul(%0, %1)
    %4:f64[] = add(%2, %3)
    outputs: %4

-- the graph of grad f: derivatives are ops too --
    params: %0:f64[]
    %3:f64[] = const 1.0
    %5:f64[] = const 1.0
    %1:f64[] = sin(%0)
    %2:f64[] = mul(%0, %1)
    %4:f64[] = add(%2, %3)
    %6:f64[] = mul(%5, %1)
    %7:f64[] = mul(%0, %5)
    %8:f64[] = cos(%0)
    %9:f64[] = mul(%7, %8)
    %10:f64[] = add(%6, %9)
    outputs: %10

-- jit: traced on the first call for each input type --
  [traced]
  fast 1                         1.8414709848078965
  fast 2 (cached)                2.8185948536513634
  [traced]
  fast [1 2] (new shape)         [1.8414709848078965 2.8185948536513634]
  deriv fast 1                   1.3817732906760363

-- while tracing there is no data to branch on --
  leaky 2, eager                 2.0
  Ir.make1 leaky: stage tracer #19 f64[] has no concrete value: stage only knows its type, so its data cannot be read (e.g. for an if on a value)

-- Control.cond traces both branches, so it stages --
    params: %0:f64[]
    %1:f64[] = const 0.0
    %2:f64[] = greater(%0, %1)
    %3:f64[] = cond(%2, %0, %0)
      then:
        params: %0:f64[]
        outputs: %0
      else:
        params: %0:f64[]
        %1:f64[] = const 0.1
        %2:f64[] = mul(%1, %0)
        outputs: %2
    outputs: %3
  fast leaky -3                  -0.30000000000000004
  grad fast leaky -3             0.1

=== control: cond and while_loop on data ===

-- cond: both branches are traced, one runs --
  huber 0.5                      0.125
  grad huber 0.5                 0.5
  huber -3                       2.5
  grad huber -3                  -1.0

-- cond under jit: one trace serves both branches --
  [traced]
  fast 0.5                       0.125
  fast -3                        2.5
  grad fast -3                   -1.0

-- the graph: cond holds its branches --
    params: %0:f64[]
    %2:f64[] = const 0.0
    %5:f64[] = const 1.0
    %7:f64[] = const 1.0
    %1:f64[] = neg(%0)
    %3:f64[] = less(%0, %2)
    %4:f64[] = select(%3, %1, %0)
    %6:f64[] = greater(%4, %5)
    %8:f64[] = sub(%7, %6)
    %9:f64[] = cond(%8, %0, %0)
      then:
        params: %0:f64[]
        %1:f64[] = const 0.5
        %2:f64[] = mul(%1, %0)
        %3:f64[] = mul(%2, %0)
        outputs: %3
      else:
        params: %0:f64[]
        %2:f64[] = const 0.0
        %5:f64[] = const 0.5
        %1:f64[] = neg(%0)
        %3:f64[] = less(%0, %2)
        %4:f64[] = select(%3, %1, %0)
        %6:f64[] = sub(%4, %5)
        outputs: %6
    outputs: %9

-- while_loop: Newton's method for sqrt --
  sqrt 2                         1.414213562373095
    steps                        5.0
  sqrt 100                       10.0
    steps                        8.0

-- a loop under jit: the trip count is decided at run time --
  [traced]
  fast_root 2                    1.414213562373095
  fast_root 100                  10.0

-- derivatives of a loop: forward mode --
  deriv root 2                   0.35355339059327373
  by hand: 1 / (2 sqrt 2)        0.35355339059327373
  deriv fast_root 2              0.35355339059327373

-- reverse mode needs a fixed trip count --
  grad root: vjp of while_loop: reverse mode needs a fixed trip count; use forward mode (Ad.jvp, Ad.jacfwd) or an OCaml loop

=== extending: a new primitive and a new interpreter ===

-- softplus, a new primitive --
  softplus xs                    [0.31326168751822286 0.6931471805599453 1.3132616875182228]
  deriv softplus xs              [0.2689414213699951 0.5 0.7310585786300049]
  logistic xs (by hand)          [0.2689414213699951 0.5 0.7310585786300049]
  grad (sum (softplus xs))       [0.2689414213699951 0.5 0.7310585786300049]

-- the primitives run by deriv softplus --
    softplus
    neg
    exp
    broadcast
    add
    broadcast
    div
    mul
  result                         [0.2689414213699951 0.5 0.7310585786300049]
